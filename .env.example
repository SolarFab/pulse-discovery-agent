# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────
# Demo default points at the local docker-compose Postgres (make db-up).
# In production, set this to your real Supabase pooler connection string.
DATABASE_URL=postgresql://pulse:pulse@localhost:5433/pulse

# ── LLM (model-agnostic via an OpenAI-compatible gateway) ───────────────
# Route through OpenRouter (or set your own base URL / provider).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-...
# Model id for the scout's reasoning (any OpenAI-compatible id).
SCOUT_MODEL=openai/gpt-4o-mini

# ── Observability (optional) ────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# ── Discovery limits (cost control) ─────────────────────────────────────
SCOUT_MAX_VENUES=25          # cap venues per run
SCOUT_RESCOUT_DAYS=21        # re-scout a source only after it goes stale this long
